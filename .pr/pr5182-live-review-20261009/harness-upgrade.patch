diff --git a/.agents/skills/verify-openhands/scripts/lib/backend-selection.mjs b/.agents/skills/verify-openhands/scripts/lib/backend-selection.mjs
new file mode 100644
index 000000000..255d8beda
--- /dev/null
+++ b/.agents/skills/verify-openhands/scripts/lib/backend-selection.mjs
@@ -0,0 +1,29 @@
+import { resolve } from "node:path";
+
+// A backend choice replaces its previous selector while preserving the run's
+// state, ports and other backend. Shell selectors never participate here.
+export function withBackendSelection(saved, flags) {
+  const env = { ...saved };
+  for (const [prefix, backend] of [
+    ["sdk", "AGENT_SERVER"],
+    ["automation", "AUTOMATION"],
+  ]) {
+    const choices = [
+      [`${prefix}-path`, `OH_${backend}_LOCAL_PATH`],
+      [`${prefix}-ref`, `OH_${backend}_GIT_REF`],
+      [`${prefix}-version`, `OH_${backend}_VERSION`],
+    ];
+    const selected = choices.filter(([flag]) => flags[flag] !== undefined);
+    if (selected.length > 1)
+      throw new Error(
+        `Choose only one of ${choices.map(([flag]) => `--${flag}`).join(", ")}.`,
+      );
+    if (!selected.length) continue;
+    const [flag, name] = selected[0];
+    if (typeof flags[flag] !== "string" || !flags[flag].trim())
+      throw new Error(`--${flag} requires a value.`);
+    for (const [, selector] of choices) delete env[selector];
+    env[name] = flag.endsWith("-path") ? resolve(flags[flag]) : flags[flag];
+  }
+  return env;
+}
