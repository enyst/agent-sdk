+test("restart backend selection preserves state and replaces only the chosen backend", () => {
+  const saved = {
+    HOME: "/run/private/home",
+    OH_CANVAS_SAFE_STATE_DIR: "/run/private/state",
+    OH_CANVAS_SAFE_BACKEND_PORT: "18831",
+    OH_AGENT_SERVER_VERSION: "1.0.0",
+    OH_AUTOMATION_GIT_REF: "main",
+  };
+  assert.deepEqual(withBackendSelection(saved, {}), saved);
+  const upgraded = withBackendSelection(saved, { "sdk-path": "./sdk-pr" });
+  assert.deepEqual(upgraded, {
+    HOME: saved.HOME,
+    OH_CANVAS_SAFE_STATE_DIR: saved.OH_CANVAS_SAFE_STATE_DIR,
+    OH_CANVAS_SAFE_BACKEND_PORT: saved.OH_CANVAS_SAFE_BACKEND_PORT,
+    OH_AGENT_SERVER_LOCAL_PATH: resolve("./sdk-pr"),
+    OH_AUTOMATION_GIT_REF: "main",
+  });
+  assert.equal(saved.OH_AGENT_SERVER_VERSION, "1.0.0");
+  const repinned = withBackendSelection(upgraded, {
+    "sdk-version": "2.0.0",
+    "automation-version": "3.0.0",
+  });
+  assert.equal(repinned.OH_AGENT_SERVER_VERSION, "2.0.0");
+  assert.equal(repinned.OH_AGENT_SERVER_LOCAL_PATH, undefined);
+  assert.equal(repinned.OH_AUTOMATION_VERSION, "3.0.0");
+  assert.equal(repinned.OH_AUTOMATION_GIT_REF, undefined);
+  const fromRef = withBackendSelection(repinned, {
+    "sdk-ref": "feature/events",
+  });
+  assert.equal(fromRef.OH_AGENT_SERVER_GIT_REF, "feature/events");
+  assert.equal(fromRef.OH_AGENT_SERVER_VERSION, undefined);
+});
+
+test("launch and restart refuse conflicting or valueless backend selectors before side effects", () => {
+  for (const verb of ["launch", "restart"]) {
+    for (const prefix of ["sdk", "automation"]) {
+      const conflict = run([
+        verb,
+        `--${prefix}-version`,
+        "1.0.0",
+        `--${prefix}-path`,
+        "/sdk-pr",
+      ]);
+      assert.equal(conflict.status, 2, conflict.stdout + conflict.stderr);
+      assert.match(conflict.json.error, /Choose only one/);
+      const missing = run([verb, `--${prefix}-ref`]);
+      assert.equal(missing.status, 2, missing.stdout + missing.stderr);
+      assert.match(missing.json.error, /requires a value/);
+    }
+  }
+  const help = run(["help", "restart"]);
+  assert.match(help.stdout, /--sdk-version V/);
+  assert.match(help.stdout, /--automation-version V/);
+  assert.match(help.stdout, /preserving conversations/);
+});
